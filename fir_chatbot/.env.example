# ============================================================
# FIR Chatbot - environment configuration
# Copy this file to ".env" and fill in YOUR values.
# The ".env" file is ignored by git so your keys stay private.
# ============================================================

# Which LLM provider to use. Options:
#   groq     -> Groq cloud, FREE tier, fastest to set up (recommended)
#   gemini   -> Google AI Studio, FREE tier
#   ollama   -> runs a model locally on your Mac, 100% free & offline
#   openai_compatible -> any server that speaks the OpenAI chat API
#                        (OpenRouter free models, LM Studio, etc.)
#   demo     -> NO API KEY needed: replays the synthetic scenarios in data/sample_cases
#   mock     -> no LLM at all; empty answers (used by unit tests)
LLM_PROVIDER=groq

# API key for the chosen provider (NOT needed for ollama or mock).
#   Groq:   https://console.groq.com/keys      (free account)
#   Gemini: https://aistudio.google.com/apikey  (free account)
LLM_API_KEY=

# Model name for the chosen provider. Sensible free defaults:
#   groq:   openai/gpt-oss-120b   (best free choice; openai/gpt-oss-20b is faster/smaller)
#   gemini: gemini-2.0-flash
#   ollama: llama3.1:8b   (run `ollama pull llama3.1:8b` first)
LLM_MODEL=openai/gpt-oss-120b

# Base URL. Leave blank to use the provider's default.
#   groq default:   https://api.groq.com/openai/v1
#   ollama default: http://localhost:11434/v1
#   openrouter:     https://openrouter.ai/api/v1
LLM_BASE_URL=

# Creativity of the model. 0 = most deterministic. Keep low for extraction.
LLM_TEMPERATURE=0.0

# Seconds to wait for the LLM before giving up.
LLM_TIMEOUT_SECONDS=60

# Use the LLM to phrase follow-up questions naturally (true/false).
# If false, deterministic template questions are used (zero LLM cost).
LLM_QUESTION_WORDING=true

# Use the LLM for an extra contradiction pass (true/false).
LLM_CONTRADICTION_CHECK=true

# Where the SQLite database file lives.
DATABASE_URL=sqlite:///./data/fir_chatbot.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Comma-separated list of frontend origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
