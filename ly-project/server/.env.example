# Mongo Atlas — the same bail_rag cluster the data pipeline wrote to.
MONGO_URI=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

PORT=8080

# FIR Assistant backend (FastAPI) — proxied through /api/fir/*
FIR_BACKEND_URL=http://localhost:8000

# Signs login session cookies (min 32 chars). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep it secret; changing it logs every user out.
JWT_SECRET=

# Shared secret sent to the FIR backend on every proxied request, proving the
# request came through this server's login check. Must be IDENTICAL to
# PROXY_SHARED_SECRET in fir_chatbot/.env. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FIR_SHARED_SECRET=
